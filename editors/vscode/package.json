{
  "name": "zyra-vscode",
  "displayName": "Zyra Programming Language v2.0",
  "description": "Official VS Code Extension for Zyra v2.0 (LSP language server, autocompletion, hover docs, Code Lens, formatter, debugger, and test runner).",
  "version": "2.0.0",
  "publisher": "AndreaPallotta",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndreaPallotta/zyra"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:zyra"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zyra",
        "aliases": ["Zyra", "zyra"],
        "extensions": [".zy"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "zyra",
        "scopeName": "source.zyra",
        "path": "./syntaxes/zyra.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "zyra",
        "path": "./snippets/zyra.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "zyra.run",
        "title": "Zyra: Run Native Binary"
      },
      {
        "command": "zyra.build",
        "title": "Zyra: Build Target"
      },
      {
        "command": "zyra.fmt",
        "title": "Zyra: Format Source Code"
      },
      {
        "command": "zyra.test",
        "title": "Zyra: Run Unit Tests"
      }
    ],
    "iconThemes": [
      {
        "id": "zyra-file-icons",
        "label": "Zyra File Icons",
        "path": "./icon-theme.json"
      }
    ]
  }
}
