def test_task_nursery(): Int {
  const g = task.group()
  const ch = chan.new()
  const tx1 = chan.clone(ch)
  const tx2 = chan.clone(ch)

  task.spawn(g, move || {
    chan.send(tx1, "worker1_finished")
  })

  task.spawn(g, move || {
    chan.send(tx2, "worker2_finished")
  })

  task.wait_all(g)

  const r1 = chan.recv(ch)
  const r2 = chan.recv(ch)

  if (len(r1) > 0 && len(r2) > 0 && r1 != r2) {
    const completed = task.with_timeout(500, move || {
      time.sleep(10)
    })
    if (completed) {
      print("[PASS] Structured task nurseries and with_timeout verified")
      return 1
    }
  }
  print("[FAIL] Task nursery verification failed")
  return 0
}

def test_zero_copy_buffers(): Int {
  const b = buf.new(16)
  if (buf.len(b) != 16) {
    return 0
  }

  buf.write(b, 0, "hello world")
  const str_val = buf.to_str(b)
  if (!contains(str_val, "hello world")) {
    return 0
  }

  const sub = buf.slice(b, 0, 5)
  if (buf.to_str(sub) != "hello") {
    return 0
  }

  const b2 = buf.from_str("zyra260")
  const hex_val = buf.to_hex(b2)
  const b64_val = buf.to_base64(b2)
  if (len(hex_val) != 14 || len(b64_val) == 0) {
    return 0
  }

  const rb = buf.ring(8)
  buf.ring_write(rb, "12345678")
  buf.ring_write(rb, "AB")
  const read_back = buf.ring_read(rb, 4)
  if (len(read_back) != 4) {
    return 0
  }

  print("[PASS] Zero-copy buffers and streaming ring buffer verified")
  return 1
}

def test_crypto_cipher_and_passwords(): Int {
  const key = "1234567890123456"
  const nonce = "123456789012"
  const plaintext = "Zyra v2.6.0 Flagship Cryptographic Security"
  const aad = "header_authenticated_data"

  const encrypted = crypto.encrypt_aes_gcm(key, nonce, plaintext, aad)
  if (len(encrypted) == 0) {
    return 0
  }

  const decrypted = crypto.decrypt_aes_gcm(key, nonce, encrypted, aad)
  if (decrypted != plaintext) {
    return 0
  }

  const tampered_decrypted = crypto.decrypt_aes_gcm(key, nonce, encrypted, "wrong_aad")
  if (len(tampered_decrypted) != 0) {
    return 0
  }

  const password = "super_secret_password_2026"
  const hashed = crypto.hash_password(password)
  if (!contains(hashed, "pbkdf2_sha256")) {
    return 0
  }

  const valid = crypto.verify_password(password, hashed)
  const invalid = crypto.verify_password("wrong_password", hashed)
  if (!valid || invalid) {
    return 0
  }

  print("[PASS] AES-GCM authenticated cipher suite and PBKDF2 password hashing verified")
  return 1
}

def test_config_engine(): Int {
  const sample_cfg = "app_name = ZyraService\nport = 9090\nenable_tls = true"
  const cfg = config.load(sample_cfg)

  const name = config.get(cfg, "app_name")
  const port = config.get_int(cfg, "port")
  const tls = config.get_bool(cfg, "enable_tls")

  if (name != "ZyraService" || port != 9090 || !tls) {
    return 0
  }

  env.set("ZYRA_DATABASE_PORT", "5432")
  const db_port = config.get_int(cfg, "database.port")
  if (db_port != 5432) {
    return 0
  }

  print("[PASS] Declarative configuration engine and ZYRA environment overlays verified")
  return 1
}

def test_distributed_event_bus(): Int {
  const ch = chan.new()
  const tx = chan.clone(ch)

  const sub_id = bus.sub("telemetry.*", move |topic: String, payload: String| {
    chan.send(tx, "{topic}:{payload}")
  })

  bus.pub("telemetry.cpu", "88.5")
  bus.pub("telemetry.memory", "4096")
  bus.pub("orders.created", "order_123")

  const ev1 = chan.recv(ch)
  const ev2 = chan.recv(ch)

  if (ev1 != "telemetry.cpu:88.5" || ev2 != "telemetry.memory:4096") {
    return 0
  }

  const hist = bus.history("telemetry.*", 5)
  if (len(hist) < 2) {
    return 0
  }

  const unsubbed = bus.unsub(sub_id)
  if (!unsubbed) {
    return 0
  }

  bus.clear()

  print("[PASS] Distributed event bus with wildcard matching and history verified")
  return 1
}

def test_declarative_schema_validation(): Int {
  const s_str = schema.string()
  const s_str_bounded = schema.max(schema.min(s_str, 3), 8)
  const s_req = schema.required(s_str_bounded)

  if (!schema.is_valid(s_req, "zyra")) {
    return 0
  }
  if (schema.is_valid(s_req, "zy")) {
    return 0
  }
  if (schema.is_valid(s_req, "zyra_toolchain_framework")) {
    return 0
  }
  if (schema.is_valid(s_req, "")) {
    return 0
  }

  const s_int = schema.int()
  const s_int_bounded = schema.max(schema.min(s_int, 10), 100)
  if (!schema.is_valid(s_int_bounded, "42")) {
    return 0
  }
  if (schema.is_valid(s_int_bounded, "5")) {
    return 0
  }
  if (schema.is_valid(s_int_bounded, "150")) {
    return 0
  }
  if (schema.is_valid(s_int_bounded, "not_a_number")) {
    return 0
  }

  const rules = "{\"name\": {\"type\": \"string\", \"min\": 2, \"required\": true}, \"port\": {\"type\": \"int\", \"min\": 1024, \"max\": 65535}}"
  const good_json = "{\"name\": \"server\", \"port\": 8080}"
  const bad_json = "{\"name\": \"s\", \"port\": 80}"

  const errs_good = schema.validate_json(rules, good_json)
  const errs_bad = schema.validate_json(rules, bad_json)

  if (len(errs_good) != 0 || len(errs_bad) != 2) {
    return 0
  }

  print("[PASS] Declarative schema validation engine and JSON verification verified")
  return 1
}

def test_snapshot_testing(): Int {
  const payload = "Zyra v2.6.0 Flagship Snapshot Golden File"
  const snap1 = test.snapshot("v260_golden_spec", payload)
  if (!snap1) {
    return 0
  }

  const snap2 = test.snapshot("v260_golden_spec", payload)
  if (!snap2) {
    return 0
  }

  print("[PASS] Snapshot and golden-file verification verified")
  return 1
}

def test_binary_protocol_codec(): Int {
  const packed = bin.pack(">I2sH", "1000, OK, 42")
  if (len(packed) != 16) {
    return 0
  }

  const unpacked = bin.unpack(">I2sH", packed)
  if (len(unpacked) != 3) {
    return 0
  }
  if (unpacked[0] != "1000" || unpacked[1] != "OK" || unpacked[2] != "42") {
    return 0
  }

  const h16 = bin.pack_u16_be(1000)
  const u16_val = bin.unpack_u16_be(h16)
  if (u16_val != 1000) {
    return 0
  }

  const h16_le = bin.pack_u16_le(1000)
  const u16_le_val = bin.unpack_u16_le(h16_le)
  if (u16_le_val != 1000) {
    return 0
  }

  const h32 = bin.pack_u32_be(70000)
  const u32_val = bin.unpack_u32_be(h32)
  if (u32_val != 70000) {
    return 0
  }

  const h32_le = bin.pack_u32_le(70000)
  const u32_le_val = bin.unpack_u32_le(h32_le)
  if (u32_le_val != 70000) {
    return 0
  }

  print("[PASS] Endian-aware binary protocol codec and fixed-width packers verified")
  return 1
}

def test_terminal_ui_prompts(): Int {
  const answer = tui.prompt("Enter cluster name", "prod-primary")
  if (answer != "prod-primary") {
    return 0
  }

  const confirmed = tui.confirm("Enable distributed replication?", true)
  if (!confirmed) {
    return 0
  }

  const options = ["raft", "paxos", "gossip"]
  const selected = tui.select("Select consensus engine", options, 1)
  if (selected != 1) {
    return 0
  }

  print("[PASS] Terminal UI prompts and headless fallback verified")
  return 1
}

def main(): Int {
  print("==========================================")
  print("      Zyra v2.6.0 Feature Verification    ")
  print("==========================================")

  const t1 = test_task_nursery()
  const t2 = test_zero_copy_buffers()
  const t3 = test_crypto_cipher_and_passwords()
  const t4 = test_config_engine()
  const t5 = test_distributed_event_bus()
  const t6 = test_declarative_schema_validation()
  const t7 = test_snapshot_testing()
  const t8 = test_binary_protocol_codec()
  const t9 = test_terminal_ui_prompts()

  const passed = t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9
  print("------------------------------------------")
  print("Results: {passed}/9 v2.6.0 Tests PASSED")
  print("==========================================")

  if (passed == 9) {
    return 0
  }
  return 1
}
