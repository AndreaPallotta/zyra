def print_help(): Int {
  print("==================================================")
  print("                   Zyra CLI                       ")
  print("==================================================")
  print("Usage: zyra <command> [options]")
  print("Commands:")
  print("  init <project-name>  Initialize a new Zyra project directory")
  print("  build <file.zy>      Compile Zyra file to native binary or JS")
  print("  run <file.zy>        Compile and run Zyra file in one step")
  print("  add <crate>          Add a Rust crate dependency to zyra.json")
  print("  pkg                  Resolve & install project dependencies")
  print("  test                 Run test runner test_runner.zy")
  print("  repl                 Launch interactive terminal REPL shell")
  print("  version              Display version information")
  print("  help                 Show this help menu")
  print("Options:")
  print("  --target <rust|js>   Target output generator (default: rust)")
  print("  --native             Compile native executable binary via rustc")
  print("==================================================")
  return 0
}

def main(): Int {
  print("Self-Hosted Zyra Compiler CLI v2.2.0 successfully executed.")
  const _ = print_help()
  return 0
}

const _exit_code = main()
