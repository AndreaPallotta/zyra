{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zyra",
  "scopeName": "source.zyra",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zyra",
          "match": "//.*$"
        },
        {
          "name": "comment.block.zyra",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zyra",
          "match": "\\b(if|else|match|return|import|export|from)\\b"
        },
        {
          "name": "keyword.other.declaration.zyra",
          "match": "\\b(const|var|def|struct|enum)\\b"
        },
        {
          "name": "keyword.other.fn.zyra",
          "match": "\\bprint\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.zyra",
          "match": "\\b(Int|String|Bool|BigInt|Void)\\b"
        },
        {
          "name": "entity.name.type.struct.zyra",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zyra",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.zyra",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.line.zyra",
              "begin": "\\{",
              "end": "\\}",
              "captures": {
                "0": { "name": "punctuation.section.embedded.zyra" }
              },
              "patterns": [
                { "include": "source.zyra" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.zyra",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.zyra",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.zyra",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.zyra",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.zyra" }
          }
        }
      ]
    }
  }
}
